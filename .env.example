# Copy to .env.local. Leave the Sanity values empty to use the built-in content in src/content/fallback.ts.
# These two values are public (they identify the dataset); never put API tokens or deploy-hook URLs here.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Contact form: messages are sent with Resend (https://resend.com). Keep the key secret: set it in
# .env.local and in Vercel's environment variables, never in code. Without it the form asks visitors
# to email you directly. The default sender (onboarding@resend.dev) only delivers to the email your
# Resend account uses, so sign up with the address you want messages to reach, or verify a domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Canonical site URL used for metadata and the social preview image.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
